digraph AST {
  node [shape=box, style=filled, fillcolor=white];
  node0 [label="Program"];
  node1 [label="If"];
  node2 [label="Condition: x>5&&y<10", shape=ellipse, color=red];
  node1 -> node2 [label="Cond"];
  node3 [label="Block"];
  node1 -> node3 [label="Then"];
  node4 [label="Block"];
  node1 -> node4 [label="Else"];
  node0 -> node1;
}
