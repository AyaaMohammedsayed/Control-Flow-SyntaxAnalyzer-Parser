digraph AST {
  node [shape=box, style=filled, fillcolor=white];
  node0 [label="Program"];
  node1 [label="If"];
  node2 [label="score>50", shape=ellipse, color=red];
  node1 -> node2 [label="Cond"];
  node3 [label="Block"];
  node4 [label="Assign"];
  node5 [label="status", shape=note];
  node4 -> node5 [label="Target"];
  node6 [label="Expr"];
  node6 [label="1", shape=plaintext];
  node4 -> node6 [label="Expr"];
  node3 -> node4;
  node1 -> node3 [label="Then"];
  node0 -> node1;
}
